#!/usr/bin/bash
# Runs only in the live user's session. No disk formatting, mounting, or network upload.
set -u
export PATH=/usr/local/bin:/usr/bin:/bin
mkdir -p "$HOME/.local/state/kavika"
exec >>"$HOME/.local/state/kavika/session.log" 2>&1
echo "KAVIKA_SESSION_START"

# Retry the actual wallpaper operation, not merely the object's existence:
# Plasma publishes its D-Bus object before all methods are usable at startup.
ready=0
for attempt in $(seq 1 45); do
    if plasma-apply-wallpaperimage --fill-mode preserveAspectFit /usr/share/kavika/logo.png; then
        ready=1
        break
    fi
    sleep 2
done
if [ "$ready" -eq 1 ]; then
    qdbus-qt6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        const all = desktops();
        for (let i = 0; i < all.length; i++) {
            all[i].currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
            all[i].writeConfig("Color", "#D2AD2D");
        }
    ' || true
fi

mkdir -p "$HOME/Desktop"
cp /usr/share/applications/kavika-test-centre.desktop "$HOME/Desktop/"
chmod u+x "$HOME/Desktop/kavika-test-centre.desktop"

echo "KAVIKA_SESSION_READY"
if grep -qw 'kavika.install=1' /proc/cmdline 2>/dev/null; then
    # The "Install Kavi'ka OS" boot entry: run the consent-driven pre-flight instead of the
    # Test Centre. kavika.target=/kavika.confirm= are an explicit, documented override for
    # automated/disposable validation; without them the pre-flight asks for the device.
    mode=$(sed -n 's/.*kavika\.mode=\([^ ]*\).*/\1/p' /proc/cmdline); mode="${mode:-graphical}"
    target=$(sed -n 's/.*kavika\.target=\([^ ]*\).*/\1/p' /proc/cmdline)
    confirm=$(sed -n 's/.*kavika\.confirm=\([^ ]*\).*/\1/p' /proc/cmdline)
    args=(/usr/local/sbin/kavika-install --mode "$mode")
    if [ -n "$target" ] && [ -n "$confirm" ]; then
        args+=(--device "$target" --confirm-device "$confirm" --yes)
    fi
    exec "${args[@]}"
fi
# The live ISO is not an installation release. Remove only live-session installer shortcuts.
rm -f "$HOME/Desktop/liveinst.desktop" "$HOME/Desktop/org.fedoraproject.AnacondaInstaller.desktop"
kavika-test-centre
