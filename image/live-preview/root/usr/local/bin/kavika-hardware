#!/usr/bin/python3
"""Read-only, intentionally limited hardware report for the live preview."""
import argparse
import json
import os
import platform
from pathlib import Path
import subprocess


def read_optional(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def run(args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=15)
        return result.stdout.strip() if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def sanitize_disks(data):
    """Only disk model/capacity/path; never serials, UUIDs, labels or file data."""
    fields = ("name", "size", "type", "tran", "rm", "ro", "model")
    return [
        {key: disk.get(key) for key in fields}
        for disk in data.get("blockdevices", [])
        if disk.get("type") == "disk"
    ]


def report():
    cpu = read_optional("/proc/cpuinfo") or ""
    memory = read_optional("/proc/meminfo") or ""
    model = next((line.split(":", 1)[1].strip() for line in cpu.splitlines()
                  if line.startswith("model name")), None)
    flags = next((line.split(":", 1)[1].split() for line in cpu.splitlines()
                  if line.startswith("flags")), [])
    total = next((int(line.split()[1]) for line in memory.splitlines()
                  if line.startswith("MemTotal:")), None)
    raw_disks = run(["lsblk", "--json", "--bytes", "--nodeps",
                     "--output", "NAME,SIZE,TYPE,TRAN,RM,RO,MODEL"])
    try:
        disks = sanitize_disks(json.loads(raw_disks or "{}"))
    except (ValueError, TypeError):
        disks = None
    pci = run(["lspci"])
    graphics = [line for line in (pci or "").splitlines()
                if any(word in line for word in ("VGA compatible", "3D controller", "Display controller"))]
    return {
        "preview": "Kavika 0.1.0 live diagnostic preview",
        "expected_target": "Surface Pro 8 Wi-Fi, model 1983; actual hardware below",
        "system_model": read_optional("/sys/class/dmi/id/product_name"),
        "architecture": platform.machine(),
        "kernel": platform.release(),
        "cpu_model": model,
        "logical_cpus": os.cpu_count(),
        "system_reported_memory_kib": total,
        "cpu_virtualisation_flag": "vmx" in flags or "svm" in flags,
        "kvm_device_exists": Path("/dev/kvm").exists(),
        "kvm_accessible_to_current_user": os.access("/dev/kvm", os.R_OK | os.W_OK),
        "graphics_controllers": graphics,
        "disks": disks,
        "session_type": os.environ.get("XDG_SESSION_TYPE"),
        "limitations": [
            "This is inventory, not a hardware or Windows-workspace acceptance pass.",
            "No serial numbers, UUIDs, usernames, MACs, IP addresses, keys or user files are collected.",
            "Factory casing says 128 GB; current installed disk size is reported separately.",
            "Windows and Comet are not installed in this preview.",
        ],
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args()
    print(json.dumps(report(), indent=2))


if __name__ == "__main__":
    main()
