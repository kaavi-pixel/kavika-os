#!/usr/bin/bash
set -u
export PATH=/usr/local/bin:/usr/bin:/bin

while true; do
    choice=$(kdialog --title "Kavi'ka OS · Live preview" \
        --icon /usr/share/kavika/logo.png \
        --menu "Kavi'ka live preview (HP Envy install target, Laptop Studio test machine). Windows is not included; the workspace plumbing ships. Internal installation is disabled." \
        guide "Read the test guide" \
        hardware "View hardware report" \
        save "Save a hardware report" \
        switch "Switch workspace (Meta+F12)" \
        windows "Windows workspace status" \
        settings "Open system settings" \
        close "Close") || exit 0
    case "$choice" in
        guide)
            kdialog --title "Kavi'ka test guide" --textbox /usr/share/kavika/START-HERE.txt 760 600
            ;;
        hardware)
            report=$(mktemp)
            kavika-hardware > "$report"
            kdialog --title "Hardware report · not an acceptance pass" --textbox "$report" 800 600
            rm -f -- "$report"
            ;;
        save)
            output=$(kdialog --getsavefilename "$HOME/kavika-hardware.json" "*.json" \
                --title "Save report; the live session is temporary") || continue
            [ -n "$output" ] || continue
            if [ -e "$output" ]; then
                kdialog --warningyesno "Replace the existing report file?" || continue
            fi
            if kavika-hardware > "$output"; then
                kdialog --msgbox "Report saved. Review it before sharing. Files in the live home folder disappear after shutdown unless you copy them somewhere persistent."
            else
                kdialog --error "Could not save the report. Check the destination."
            fi
            ;;
        switch)
            qdbus-qt6 org.kde.kglobalaccel /component/kwin invokeShortcut KavikaToggle \
                || kdialog --sorry "Use Meta+F12 or the virtual desktop controls in System Settings."
            ;;
        windows)
            kdialog --title "Windows workspace status" --msgbox \
                "Desktop 2 is labelled 'Windows (not installed)': it is a LINUX workspace, not Windows.\n\nWhere Windows actually stands:\n- Proven separately in a KVM feasibility guest on the test machine: a full Windows 11 installs to the desktop, boots self-contained (its own disk, no boot stick), and the browser (Firefox) opens in it.\n- This image now ships the plumbing: kavika-windows-workspace and the guest launcher.\n- This live preview carries NO Windows, NO licence, and NO virtualization stack (qemu/swtpm), so the guest cannot run from this session.\n\nSee /usr/share/kavika/WINDOWS.txt for the provisioning path on an installed system."
            ;;
        settings) systemsettings ;;
        close) exit 0 ;;
    esac
done
