PRETTY_NAME="Kavi'ka OS 0.1.0 (Live Preview, Fedora KDE 44)"
ANSI_COLOR="0;33"
VARIANT="Live Preview"
VARIANT_ID=live-preview
HOME_URL="https://github.com/kaavi-pixel/kavika-os"
SUPPORT_URL="https://github.com/kaavi-pixel/kavika-os/issues"
BUG_REPORT_URL="https://github.com/kaavi-pixel/kavika-os/issues"
CPE_NAME="cpe:/o:fedoraproject:fedora:44"
