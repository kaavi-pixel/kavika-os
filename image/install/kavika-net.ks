# Kavi'ka OS installer kickstart — dnf/netinst build (Path B)
#
# Unlike the live preview, this drives Anaconda in a real dnf-based install, where
# %packages, explicit `part`, and unattended automation are all honored. The install
# source is the Fedora 44 Everything repo over the network; stage2 (images/install.img)
# and this kickstart live on the media and are referenced via inst.stage2=hd:LABEL=...
# and inst.ks=hd:LABEL=...:/kavika.ks.
#
# Consent model (fail-closed): nothing is partitioned until the operator has named the
# exact target device TWICE on the kernel command line (kavika.target= and
# kavika.confirm=). The %pre below re-implements the same refusals as tools/kavika-install.py:
# mismatch, unknown, not-a-whole-disk, mounted, too small, pseudo-disk. On any failure it
# exits non-zero, which makes Anaconda abort before touching storage.

lang en_GB.UTF-8
keyboard uk
timezone UTC --utc
# Text-mode Anaconda: an unattended install with the progress visible on the serial console.
# D32: text mode makes Anaconda set the INSTALLED system's default target to
# multi-user.target, so a finished install boots to a black text console instead of the
# desktop. The %post below sets graphical.target explicitly to undo that.
text

url --url="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/"

# D35: the installed system must come up networked. Without a saved connection it has no route
# and no DNS, so `dnf` and the Windows provisioner's downloads fail. Observed on the first
# physical install: `sudo dnf install sddm` died with "Temporary failure in name resolution".
# --device=link activates the first wired link; --onboot=yes makes it persist.
network --bootproto=dhcp --device=link --activate --onboot=yes

# The storage block is scoped to the confirmed device and generated by %pre below.
%include /tmp/kavika-storage.ks

# D46: first boot must NOT depend on initial-setup. Its GUI logged "starting the UI" yet never
# displayed on any VT in testing, and because initial-setup.service is ordered before
# display-manager.service the boot never reached SDDM at all - the machine sat on a text boot log
# indefinitely. Masking that single service made the SDDM greeter appear immediately, proving the
# graphics stack was never the problem. So the account is created HERE instead, and first boot
# goes straight to a working graphical login.
#
# The password below is a PUBLIC, DOCUMENTED TEMPORARY password, not a secret: it ships in this
# kickstart on the install media deliberately. %post runs `chage -d 0`, so it must be replaced at
# the first login. root stays locked.
user --name=calebz --groups=wheel --password=kavika --plaintext
firstboot --disable
rootpw --lock

%packages
@kde-desktop-environment
# D34: the kde-desktop-environment group does NOT pull a display manager, so a system
# installed with it alone has Plasma but nothing to start it, and boots to a text console.
# sddm is the KDE display manager; without it graphical.target has nothing to run.
sddm
# The virtualization stack the live preview omits, so the installed system can provision and
# run the Windows workspace (docs/windows-install-recipe.md).
qemu-kvm
swtpm
swtpm-tools
edk2-ovmf
mtools
# The Windows provisioning tooling the overlay ships (kavika-windows-media.py) needs an
# extractor for the Windows UDF ISO, a partitioner for the boot ESP image, and a FAT
# formatter for the answer stick. 7zip provides 7z; parted and dosfstools the rest.
7zip
parted
dosfstools
virt-install
virt-manager
# D44: build a GENERIC initramfs. Fedora's dracut default is hostonly="yes", which bakes in the
# storage drivers of the machine that ran the install. Installing in a VM (or on a different
# machine) and then moving the disk leaves an initramfs without the drivers the target needs -
# for an NVMe target that means no `nvme` module and an unbootable system. This package flips
# dracut to hostonly=no, which is correct for a product meant to be installed and moved.
dracut-config-generic
initial-setup
initial-setup-gui
%end

%pre --interpreter=/usr/bin/bash --log=/root/kavika-pre.log
set -uo pipefail
# Anaconda reads "%include /tmp/kavika-storage.ks" AFTER %pre. If a check below refuses, %pre
# exits before writing that file and Anaconda reports "Unable to open input kickstart file"
# instead of the real reason, which reads as a kickstart bug rather than a refused install
# (D37). Seed it with a comment-only placeholder: harmless if reached, and it keeps the true
# refusal message as the failure the operator sees. It carries NO storage directives by design.
printf '# placeholder: the consent checks did not authorise a target; no storage directives\n' \
    > /tmp/kavika-storage.ks
TARGET=$(sed -n 's/.*kavika\.target=\([^ ]*\).*/\1/p' /proc/cmdline)
CONFIRM=$(sed -n 's/.*kavika\.confirm=\([^ ]*\).*/\1/p' /proc/cmdline)
# The size floor and layout. Default is the product layout: a 128 GiB volume for the
# Windows guest, which needs a 240 GiB disk. `kavika.compact=1` on the kernel command line
# selects a compact layout for a smaller target (about 76 GiB minimum), shrinking the guest
# volume to 40 GiB and /home to 10 GiB. Compact is for test rigs and small disks and is
# never the default; a 64 GiB guest does NOT fit in a 40 GiB volume, so provision with
# --disk-gib 32 there. See installerinstallation.md.
COMPACT=$(sed -n 's/.*kavika\.compact=\([^ ]*\).*/\1/p' /proc/cmdline)
case "$COMPACT" in
    1|yes|true) COMPACT=1 ;;
    *) COMPACT=0 ;;
esac
if [ "$COMPACT" = "1" ]; then
    MIN_BYTES=$((76 * 1024 * 1024 * 1024))
    HOME_SIZE=10240
    WIN_SIZE=40960
    ROOT_SIZE=20480
else
    MIN_BYTES=$((240 * 1024 * 1024 * 1024))
    HOME_SIZE=20480
    WIN_SIZE=131072
    ROOT_SIZE=61440
fi
fail() {
    # A dead pane is not a refusal message: the reason has to be readable on the machine in
    # front of the operator, in words that say what to do next, not only on the serial
    # console (D37). Written to the active console as well as ttyS0/tty1.
    # The candidate list is not decoration: a banner that shows only a generic placeholder
    # invites the operator to type it verbatim, which then fails as
    # "cannot inspect /dev/sd with lsblk". Name the real disks instead.
    candidates=$(lsblk -dno NAME,SIZE,MODEL 2>/dev/null \
                 | grep -vE '^[[:space:]]*(loop|zram|sr|fd|ram)' || true)
    for tty in /dev/console /dev/tty1 /dev/ttyS0; do
        {
            echo
            echo "======== Kavi'ka OS: installation NOT authorised ========"
            echo "REFUSED: $*"
            echo
            echo "Nothing has been written to any disk."
            echo
            echo "Whole disks present on this machine (pick one, the big one):"
            printf '%s\n' "$candidates"
            echo
            echo "To install, reboot, highlight \"Install Kavi'ka OS (automated)\""
            echo "in the boot menu, press e, and append to the linux line:"
            echo
            echo "    kavika.target=<DISK> kavika.confirm=<DISK>"
            echo
            echo "replacing <DISK> in BOTH places with one whole disk"
            echo "from the list above, then press Ctrl-X."
            echo "========================================================"
            echo
        } > "$tty" 2>/dev/null
    done
    echo "KAVIKA CONSENT: $*" >&2
    exit 1
}

[ -n "$TARGET" ] || fail "no kavika.target= on the kernel command line; refusing to install"
[ -n "$CONFIRM" ] || fail "no kavika.confirm= on the kernel command line; refusing to install"
[ "$TARGET" = "$CONFIRM" ] || fail "kavika.target ($TARGET) != kavika.confirm ($CONFIRM)"

case "$TARGET" in
    /dev/zram*|/dev/loop*|/dev/ram*|/dev/fd*) fail "$TARGET is a pseudo-disk";;
esac

# The installation medium is itself a whole, unmounted, large-enough real disk, so every check
# below would accept it. Refuse it by identity: naming the stick you booted from would erase the
# medium mid-install, and the disks in play are easy to confuse. Resolve the media by its label
# rather than by device letter, and compare the whole disk that carries it.
MEDIA=$(blkid -L KAVIKA 2>/dev/null | head -1)
if [ -n "$MEDIA" ]; then
    MEDIA_DISK=$(lsblk -no PKNAME "$MEDIA" 2>/dev/null | head -1)
    if [ -n "$MEDIA_DISK" ] && [ "$TARGET" = "/dev/$MEDIA_DISK" ]; then
        fail "$TARGET carries the installation media booted from; name a different disk"
    fi
fi

NAME=${TARGET#/dev/}
lsblk -J -b -o name,size,type,mountpoints "$TARGET" > /tmp/kavika-lsblk.json 2>/dev/null \
    || fail "cannot inspect $TARGET with lsblk"
python3 - "$NAME" "$MIN_BYTES" <<'PY'
import json, sys
def refuse(msg):
    print("KAVIKA CONSENT-REFUSED: " + msg, file=sys.stderr)
    try:
        with open("/dev/ttyS0", "w") as fh:
            fh.write("KAVIKA CONSENT-REFUSED: " + msg + "\n")
    except Exception:
        pass
    sys.exit(1)
name, min_bytes = sys.argv[1], int(sys.argv[2])
try:
    data = json.load(open("/tmp/kavika-lsblk.json"))
except Exception as e:
    refuse("bad lsblk output: %s" % e)
blk = (data.get("blockdevices") or [{}])[0]
if blk.get("type") != "disk":
    refuse("%s is not a whole disk" % name)
mounts = [m for m in (blk.get("mountpoints") or []) if m]
if mounts:
    refuse("%s is mounted (%s)" % (name, ",".join(mounts)))
size = int(blk.get("size", 0))
if size < min_bytes:
    refuse("%s is too small (%d < %d bytes)" % (name, size, min_bytes))
print("KAVIKA CONSENT: %s confirmed (%d GiB)" % (name, size // 2**30))
PY
[ $? -eq 0 ] || exit 1

cat > /tmp/kavika-storage.ks <<KS
ignoredisk --only-use=$TARGET
clearpart --all --initlabel --drives=$TARGET
part /boot/efi --fstype=efi --size=1024
part /boot --fstype=ext4 --size=2048
part /home --fstype=ext4 --size=$HOME_SIZE
part /var/lib/kavika/windows --fstype=ext4 --size=$WIN_SIZE
part / --fstype=ext4 --size=$ROOT_SIZE --grow
bootloader --boot-drive=$TARGET
KS
echo "KAVIKA CONSENT: storage scoped to $TARGET (compact=$COMPACT)"
%end

%post --nochroot --log=/root/kavika-overlay.log
# D4: deliver the Kavi'ka overlay delta onto the installed root. The overlay cpio is bundled
# at the root of the install media. For a cdrom install the media is already mounted as the
# source; otherwise mount it by label or device.
SYSROOT=/mnt/sysimage
[ -d /mnt/sysroot ] && SYSROOT=/mnt/sysroot
OVERLAY=""
for media in /run/install/repo /mnt/install/source /mnt/kavika-media; do
    if [ -f "$media/kavika-overlay.cpio" ]; then OVERLAY="$media/kavika-overlay.cpio"; break; fi
done
if [ -z "$OVERLAY" ]; then
    mkdir -p /mnt/kavika-media
    mount -o ro "LABEL=KAVIKA" /mnt/kavika-media 2>/dev/null \
        || mount -o ro /dev/sr0 /mnt/kavika-media 2>/dev/null \
        || mount -o ro /dev/sr1 /mnt/kavika-media 2>/dev/null
    [ -f /mnt/kavika-media/kavika-overlay.cpio ] && OVERLAY="/mnt/kavika-media/kavika-overlay.cpio"
fi
if [ -n "$OVERLAY" ]; then
    ( cd "$SYSROOT" && cpio -idmu --quiet < "$OVERLAY" )
    echo "KAVIKA-VERIFY: overlay delivered from $OVERLAY" > /dev/console
else
    echo "KAVIKA-VERIFY: overlay cpio NOT FOUND; installed system is stock Fedora KDE" > /dev/console
fi
umount /mnt/kavika-media 2>/dev/null
# Live-preview-only hooks must not run on the installed system.
rm -f "$SYSROOT/etc/xdg/autostart/kavika-live.desktop"
rm -f "$SYSROOT/var/lib/livesys/livesys-session-extra"
# D34: the overlay's SELinux relabel drop-in exists only for the live overlay, where copy-up
# leaves tmpfs labels. It runs `restorecon` over /var/lib/livesys, which does not exist on an
# installed system, so the ExecStartPost fails and takes systemd-tmpfiles-setup.service down
# with it. Many units are ordered after that service, so the failure can stall the boot before
# graphical.target and leave the system on a text console. Remove it from installed roots.
rm -rf "$SYSROOT/usr/lib/systemd/system/systemd-tmpfiles-setup.service.d"
# Installer-only files are meaningless on an installed system.
rm -f "$SYSROOT/usr/bin/liveinst" "$SYSROOT/usr/libexec/kavika/real-liveinst"
rm -f "$SYSROOT/usr/local/sbin/kavika-install" "$SYSROOT/usr/lib/kavika/installer/kavika.ks"
# D41: the overlay carries the LIVE PREVIEW identity, and %post delivers it verbatim, so an
# installed system announced itself as "Kavi'ka OS 0.1.0 (Live Preview, Fedora KDE 44)" on every
# boot. An installation is not a preview. Rewrite the identity in the installed root and drop the
# VARIANT fields rather than leaving a live-image label on a real install.
for osr in "$SYSROOT/usr/lib/os-release" "$SYSROOT/etc/os-release"; do
    [ -f "$osr" ] || continue
    sed -i \
        -e "s/^VERSION=.*/VERSION=\"0.1.0 (Fedora KDE 44)\"/" \
        -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Kavi'ka OS 0.1.0 (Fedora KDE 44)\"/" \
        -e "/^VARIANT=/d" \
        -e "/^VARIANT_ID=/d" \
        "$osr"
done
echo "KAVIKA-VERIFY: installed PRETTY_NAME=$(sed -n 's/^PRETTY_NAME=//p' "$SYSROOT/usr/lib/os-release" 2>/dev/null)" > /dev/console
# Verification evidence written to the console (serial) for the validation harness.
if grep -q 'NAME="Kavi' "$SYSROOT/etc/os-release" 2>/dev/null; then
    echo "KAVIKA-VERIFY: os-release=Kavika" > /dev/console
else
    echo "KAVIKA-VERIFY: os-release=NOT-Kavika" > /dev/console
fi
rpm -q --root="$SYSROOT" qemu-kvm swtpm edk2-ovmf mtools 7zip parted dosfstools 2>&1 | sed 's/^/KAVIKA-VERIFY: pkg /' > /dev/console
# Physical installs: Anaconda registers its boot entry with efibootmgr on whatever machine
# ran the installer. When the disk is then moved to another machine, or installed from a VM,
# that NVRAM entry does not exist there and some firmware then finds nothing to boot. Also
# provide the UEFI removable-media fallback path on the ESP: firmware that has no valid
# entry boots \EFI\BOOT\BOOTX64.EFI. shim loads the vendor second stage from its own
# compiled prefix, so copying shim alone is enough.
ESP="$SYSROOT/boot/efi"
if [ -f "$ESP/EFI/fedora/shimx64.efi" ]; then
    mkdir -p "$ESP/EFI/BOOT"
    cp -f "$ESP/EFI/fedora/shimx64.efi" "$ESP/EFI/BOOT/BOOTX64.EFI"
    echo "KAVIKA-VERIFY: ESP fallback EFI/BOOT/BOOTX64.EFI installed" > /dev/console
else
    echo "KAVIKA-VERIFY: no ESP shim found; fallback BOOTX64.EFI not installed" > /dev/console
fi
# D34: a text-mode install leaves the installed system on multi-user.target, which starts no
# display manager, so the finished system boots to a black text console instead of the desktop
# even though KDE and SDDM are installed. Point default.target at graphical.target, and make
# sure the display manager is enabled rather than relying on a preset that text mode may skip.
if systemctl --root="$SYSROOT" set-default graphical.target; then
    echo "KAVIKA-VERIFY: default target = graphical" > /dev/console
else
    echo "KAVIKA-VERIFY: default target NOT set to graphical" > /dev/console
fi
for dm in sddm gdm lightdm; do
    if [ -f "$SYSROOT/usr/lib/systemd/system/$dm.service" ]; then
        systemctl --root="$SYSROOT" enable "$dm.service" >/dev/null 2>&1 \
            && echo "KAVIKA-VERIFY: display manager enabled: $dm" > /dev/console
    fi
done
# D46: the account is created by kickstart above. Force its temporary password to be replaced at
# the first login, and make sure initial-setup cannot run and block the display manager - it hung
# before SDDM in every test, which is the whole reason the account is created at install time now.
chage -R "$SYSROOT" -d 0 calebz 2>/dev/null || chroot "$SYSROOT" chage -d 0 calebz
systemctl --root="$SYSROOT" mask initial-setup.service >/dev/null 2>&1
echo "KAVIKA-VERIFY: user calebz created; temporary password must change at first login" > /dev/console
echo "KAVIKA-VERIFY: initial-setup masked (D46), first boot goes to the display manager" > /dev/console
# Read the symlink back, so the install log shows what was actually written, not what was asked.
echo "KAVIKA-VERIFY: default.target -> $(readlink "$SYSROOT/etc/systemd/system/default.target" 2>/dev/null)" > /dev/console

# D45: the installed system must look for the ESP we actually wrote to. If /etc/fstab names a
# different ESP UUID, /boot/efi cannot be mounted and the boot falls into systemd emergency mode,
# which asks for the ROOT password - and root is deliberately locked (rootpw --lock), so NO
# password can be correct. That reads to an operator as "my password stopped working" and hides
# the real fault. Compare what fstab expects against the ESP that is really there, and correct it.
if [ -d "$SYSROOT/boot/efi" ]; then
    esp_dev=$(findmnt -no SOURCE --target "$SYSROOT/boot/efi" 2>/dev/null)
    esp_uuid=$(blkid -s UUID -o value "$esp_dev" 2>/dev/null)
    fstab_uuid=$(sed -n 's|^UUID=\([^ ]*\)[[:space:]]\+/boot/efi.*|\1|p' "$SYSROOT/etc/fstab" 2>/dev/null | head -1)
    if [ -n "$esp_uuid" ] && [ -n "$fstab_uuid" ]; then
        if [ "$esp_uuid" = "$fstab_uuid" ]; then
            echo "KAVIKA-VERIFY: ESP UUID matches fstab ($esp_uuid)" > /dev/console
        else
            echo "KAVIKA-VERIFY: ESP UUID MISMATCH disk=$esp_uuid fstab=$fstab_uuid - correcting fstab" > /dev/console
            sed -i "s|^UUID=$fstab_uuid\([[:space:]]\+/boot/efi\)|UUID=$esp_uuid\1|" "$SYSROOT/etc/fstab"
            echo "KAVIKA-VERIFY: fstab /boot/efi now -> $(sed -n 's|.*[[:space:]]\(/boot/efi\).*|UUID=|p' "$SYSROOT/etc/fstab" | head -1)$(sed -n 's|^UUID=\([^ ]*\)[[:space:]]\+/boot/efi.*|\1|p' "$SYSROOT/etc/fstab" | head -1)" > /dev/console
        fi
    else
        echo "KAVIKA-VERIFY: could not determine ESP uuid (disk='$esp_uuid' fstab='$fstab_uuid')" > /dev/console
    fi
    # An unmountable ESP must never lock the operator out of their own machine: `nofail` keeps
    # the system bootable, so a future ESP problem is a diagnostic to read rather than a wall.
    if grep -qE "[[:space:]]/boot/efi[[:space:]]" "$SYSROOT/etc/fstab" && \
       ! grep -qE "[[:space:]]/boot/efi[[:space:]]+.*nofail" "$SYSROOT/etc/fstab"; then
        sed -i "s|\([[:space:]]/boot/efi[[:space:]]\+[^[:space:]]*\)|\1,nofail|" "$SYSROOT/etc/fstab"
        echo "KAVIKA-VERIFY: /boot/efi marked nofail" > /dev/console
    fi
fi
%end

reboot
